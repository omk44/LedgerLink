@* Path: LedgerLink/Views/Festival/Delete.cshtml *@
@model LedgerLink.Models.Festival

@{
    ViewData["Title"] = SR["DeleteFestival"];
}

<div class="container mt-5">
    <h2>@ViewData["Title"]</h2>
    <h3 class="text-danger">@SR["ConfirmDeleteFestival"]</h3>
    <hr />
    <div>
        <h4>@SR["FestivalDetails"]</h4>
        <dl class="row">
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Name)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Name)
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.StartDate)
            </dt>
            <dd class="col-sm-9">
                @Model.StartDate.ToShortDateString()
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.EndDate)
            </dt>
            <dd class="col-sm-9">
                @Model.EndDate.ToShortDateString()
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.IsActive)
            </dt>
            <dd class="col-sm-9">
                @(Model.IsActive ? SR["Yes"] : SR["No"])
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Description)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Description)
            </dd>
        </dl>

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <input type="submit" value="@SR["Delete"]" class="btn btn-danger" />
            <a asp-action="Index" class="btn btn-secondary ml-2">@SR["BackToList"]</a>
        </form>
    </div>
</div>