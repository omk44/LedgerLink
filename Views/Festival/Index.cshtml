@* Path: LedgerLink/Views/Festival/Index.cshtml *@
@model IEnumerable<LedgerLink.Models.Festival>

@{
    ViewData["Title"] = "Manage Festivals";
}

<div class="container mt-5">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary">
            <i class="bi bi-calendar-event me-2"></i> @ViewData["Title"]
        </h2>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle me-1"></i> Add Festival
        </a>
    </div>

    <!-- Festival Table -->
    <div class="table-responsive shadow-sm rounded">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Name)</th>
                    <th>@Html.DisplayNameFor(model => model.StartDate)</th>
                    <th>@Html.DisplayNameFor(model => model.EndDate)</th>
                    <th>@Html.DisplayNameFor(model => model.IsActive)</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-semibold">@Html.DisplayFor(modelItem => item.Name)</td>
                        <td>@item.StartDate.ToString("dd MMM yyyy")</td>
                        <td>@item.EndDate.ToString("dd MMM yyyy")</td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge bg-success px-3 py-2">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary px-3 py-2">Inactive</span>
                            }
                        </td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info me-1">
                                <i class="bi bi-pencil-square"></i> Edit
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger me-1">
                                <i class="bi bi-trash"></i> Delete
                            </a>
                            <a asp-controller="DiscountRule" asp-action="Index" asp-route-festivalId="@item.Id" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-sliders"></i> Rules
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    .table-responsive {
        background: #fff;
        border-radius: 8px;
    }
    .table-hover tbody tr:hover {
        background-color: #f8f9fa;
    }
</style>
