@* Path: LedgerLink/Views/Home/Index.cshtml *@
@* No @model directive needed as we're using ViewBag *@
@using Microsoft.AspNetCore.Http

@{
    var shopName = (ViewBag.ShopName as string) ?? (Context.Session.GetString("ShopName") ?? "LedgerLink");
    var appName = (ViewBag.AppName as string) ?? "LedgerLink";
    ViewData["Title"] = shopName;
}

<div class="container mt-5">
    <!-- Header Section -->
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold text-gradient">@shopName @SR["HomePageTitle"]</h1>
        <p class="lead text-muted">
            @SR["LedgerSubtitle"]
            <strong class="text-primary">@appName</strong>
        </p>
        <hr class="my-4 w-50 mx-auto">
        <p class="text-secondary">@SR["QuickTools"]</p>
    </div>

    <!-- Feature Cards -->
    <div class="row justify-content-center mb-5">
        <div class="col-md-4 mb-3">
            <div class="card border-0 shadow h-100 hover-card">
                <div class="card-body text-center">
                    <div class="mb-3 text-success fs-2">
                        <i class="bi bi-box-seam"></i>
                    </div>
                    <h5 class="card-title text-success">@SR["ManageProducts"]</h5>
                    <p class="card-text">@SR["ManageProductsDesc"]</p>
                    <a asp-controller="Product" asp-action="Index" class="btn btn-outline-success">@SR["GoToProducts"]</a>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card border-0 shadow h-100 hover-card">
                <div class="card-body text-center">
                    <div class="mb-3 text-info fs-2">
                        <i class="bi bi-people"></i>
                    </div>
                    <h5 class="card-title text-info">@SR["ManageCustomers"]</h5>
                    <p class="card-text">@SR["ManageCustomersDesc"]</p>
                    <a asp-controller="Customer" asp-action="Index" class="btn btn-outline-info">@SR["GoToCustomers"]</a>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card border-0 shadow h-100 hover-card">
                <div class="card-body text-center">
                    <div class="mb-3 text-warning fs-2">
                        <i class="bi bi-qr-code-scan"></i>
                    </div>
                    <h5 class="card-title text-warning">@SR["ProcessTransactions"]</h5>
                    <p class="card-text">@SR["ProcessTransactionsDesc"]</p>
                    <a asp-controller="Transaction" asp-action="Scan" class="btn btn-outline-warning">@SR["StartScanning"]</a>
                </div>
            </div>
        </div>
    </div>

    

<style>
    .text-gradient {
        background: black;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }
    .hover-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .hover-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 20px rgba(0,0,0,0.15);
    }
</style>
