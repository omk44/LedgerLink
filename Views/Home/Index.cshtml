@* Path: LedgerLink/Views/Home/Index.cshtml *@
@* No @model directive needed as we're using ViewBag *@

@{
    ViewData["Title"] = "Welcome to " + ViewBag.ShopName; // Dynamic title
}

<div class="container mt-5">
    <!-- Header Section -->
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold text-gradient">@ViewBag.ShopName Admin Home Page</h1>
        <p class="lead text-muted">
            Your digital ledger, powered by 
            <strong class="text-primary">@ViewBag.AppName</strong>, 
            is here to simplify your business management.
        </p>
        <hr class="my-4 w-50 mx-auto">
        <p class="text-secondary">Quick access to your essential tools below</p>
    </div>

    <!-- Feature Cards -->
    <div class="row justify-content-center mb-5">
        <div class="col-md-4 mb-3">
            <div class="card border-0 shadow h-100 hover-card">
                <div class="card-body text-center">
                    <div class="mb-3 text-success fs-2">
                        <i class="bi bi-box-seam"></i>
                    </div>
                    <h5 class="card-title text-success">Manage Products</h5>
                    <p class="card-text">Add, edit, or remove items you sell.</p>
                    <a asp-controller="Product" asp-action="Index" class="btn btn-outline-success">Go to Products</a>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card border-0 shadow h-100 hover-card">
                <div class="card-body text-center">
                    <div class="mb-3 text-info fs-2">
                        <i class="bi bi-people"></i>
                    </div>
                    <h5 class="card-title text-info">Manage Customers</h5>
                    <p class="card-text">View, add, or edit customer details and generate QR codes.</p>
                    <a asp-controller="Customer" asp-action="Index" class="btn btn-outline-info">Go to Customers</a>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card border-0 shadow h-100 hover-card">
                <div class="card-body text-center">
                    <div class="mb-3 text-warning fs-2">
                        <i class="bi bi-qr-code-scan"></i>
                    </div>
                    <h5 class="card-title text-warning">Process Transactions</h5>
                    <p class="card-text">Scan customer QR codes to record sales and payments.</p>
                    <a asp-controller="Transaction" asp-action="Scan" class="btn btn-outline-warning">Start Scanning</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Analytics & Insights Section -->
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow-lg border-0 p-4 bg-light">
                <h3 class="text-center text-dark mb-4">
                    Future <span class="text-primary">Analytics</span> & Growth Insights
                </h3>
                <p class="text-muted text-center">
                    <strong>@ViewBag.AppName</strong> is evolving to give 
                    <strong>@ViewBag.ShopName</strong> smarter tools for growth. 
                    Soon, you’ll generate detailed reports to track customer behaviors and optimize sales strategies.
                </p>
                <ul class="list-group list-group-flush mt-4">
                    <li class="list-group-item bg-light">
                        <strong class="text-primary">🎉 Festival Discount Optimization:</strong>
                        Target loyal customers with festive discounts to encourage more cash sales.
                    </li>
                    <li class="list-group-item bg-light">
                        <strong class="text-primary">⚠ Credit Risk Analysis:</strong>
                        Identify customers with high outstanding credit and slow payments.
                    </li>
                    <li class="list-group-item bg-light">
                        <strong class="text-primary">📊 Sales Trend Reporting:</strong>
                        Track product sales, peak buying times, and improve inventory planning.
                    </li>
                    <li class="list-group-item bg-light">
                        <strong class="text-primary">👥 Customer Segmentation:</strong>
                        Group customers by spending, credit, and payment reliability.
                    </li>
                    <li class="list-group-item bg-light">
                        <strong class="text-primary">💳 Payment Insights:</strong>
                        Understand payment modes and timing to streamline financial operations.
                    </li>
                </ul>
                <p class="text-center mt-4 text-muted">
                    Your data is your power. Unlock growth with <strong>@ViewBag.AppName</strong>.
                </p>
            </div>
        </div>
    </div>
</div>

<style>
    .text-gradient {
        background: black;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }
    .hover-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .hover-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 20px rgba(0,0,0,0.15);
    }
</style>
