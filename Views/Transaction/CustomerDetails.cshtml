@* Path: LedgerLink/Views/Transaction/CustomerDetails.cshtml *@
@model LedgerLink.ViewModels.CustomerDetailsViewModel
@using System.Globalization;

@{
    ViewData["Title"] = $"Transaction for {Model.Customer.FullName}";
    var indiaCulture = new CultureInfo("en-IN");
    var activeFestivals = ViewBag.ActiveFestivals as IEnumerable<LedgerLink.Models.Festival>;
    var hasActiveFestival = activeFestivals != null && activeFestivals.Any();
}

<div class="container mt-5">
    <h2>Transaction for @Model.Customer.FullName</h2>
    <hr />

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <div class="col-md-4">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-info text-white">
                    <h4>Customer Information</h4>
                </div>
                <div class="card-body">
                    <p><strong>Name:</strong> @Model.Customer.FullName</p>
                    <p><strong>Phone:</strong> @Model.Customer.PhoneNumber</p>
                    <p><strong>Email:</strong> @Model.Customer.Email</p>
                    <p><strong>Address:</strong> @Model.Customer.Address</p>
                    <h5 class="text-danger"><strong>Current Balance:</strong> @Model.Customer.CurrentBalance.ToString("C", indiaCulture)</h5>
                    @if (Model.Customer.CurrentBalance > 0)
                    {
                        <form asp-controller="Transaction" asp-action="SendReminder" method="post" class="mt-3">
                            <input type="hidden" name="customerId" value="@Model.Customer.Id" />
                            <button type="submit" class="btn btn-outline-danger btn-sm w-100">Send Payment Reminder (Email)</button>
                        </form>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-success text-white">
                    <h4>Add Item to Transaction</h4>
                </div>
                <div class="card-body">
                    <form id="addItemForm" asp-controller="Transaction" asp-action="AddItem" method="post">
                        <input type="hidden" name="customerId" id="customerId" value="@Model.Customer.Id" />
                        <div class="form-group mb-3">
                            <label for="productId" class="form-label">Select Product:</label>
                            <select id="productId" name="productId" class="form-control">
                                @if (Model.Products.Any())
                                {
                                    @foreach (var product in Model.Products)
                                    {
                                        <option value="@product.Id" data-price="@product.Price" data-quantity-value="@product.QuantityValue" data-quantity-unit="@product.QuantityUnit">
                                            @product.Name (@product.QuantityValue @product.QuantityUnit) - @product.Price.ToString("C", indiaCulture)
                                        </option>
                                    }
                                }
                                else
                                {
                                    <option value="">No products available. Add some from Product Management.</option>
                                }
                            </select>
                        </div>
                        <div class="form-group mb-3">
                            <label for="quantity" class="form-label">Quantity:</label>
                            <input type="number" id="quantity" name="quantity" class="form-control" value="1" min="1" />
                        </div>
                        <div class="form-group form-check mb-3">
                            <input type="checkbox" class="form-check-input" id="isCreditTransaction" name="isCreditTransaction" value="true" />
                            <label class="form-check-label" for="isCreditTransaction">Add to Credit (Money Pending)</label>
                        </div>
                        <div class="form-group mb-3" id="paymentModeForAddItemDiv">
                            <label for="paymentMode" class="form-label">Payment Mode (if not credit):</label>
                            <select id="paymentMode" name="paymentMode" class="form-control">
                                <option value="Cash">Cash</option>
                                <option value="UPI">UPI</option>
                                <option value="Card">Card</option>
                                <option value="Bank Transfer">Bank Transfer</option>
                            </select>
                        </div>
                        @if (hasActiveFestival)
                        {
                            <div class="form-group mb-3">
                                <label for="applyDiscountFestivalId" class="form-label">Apply Festival Discount?</label>
                                <select id="applyDiscountFestivalId" name="applyDiscountFestivalId" class="form-control">
                                    <option value="">No Discount</option>
                                    @foreach (var festival in activeFestivals)
                                    {
                                        <option value="@festival.Id">@festival.Name</option>
                                    }
                                </select>
                            </div>
                        }
                        
                        <div class="alert alert-info mt-3" role="alert" id="discountInfo" style="display: none;">
                            <span id="discountMessage"></span><br/>
                            <strong>Original Amount:</strong> <span id="originalAmountSpan"></span><br/>
                            <strong>Discount Applied:</strong> <span id="discountAmountSpan"></span> <br/>
                            <strong>Final Amount:</strong> <span id="finalAmountSpan"></span>
                        </div>
                        
                        <div class="form-group mb-3">
                            <label for="notes" class="form-label">Notes (Optional):</label>
                            <textarea id="notes" name="notes" class="form-control" rows="2"></textarea>
                        </div>
                        <button type="submit" class="btn btn-success w-100">Record Sale</button>
                    </form>
                </div>
            </div>

            <div class="card shadow-sm mt-4">
                <div class="card-header bg-warning text-dark">
                    <h4>Record Payment</h4>
                </div>
                <div class="card-body">
                    <form id="addPaymentForm" asp-controller="Transaction" asp-action="AddPayment" method="post">
                        <input type="hidden" name="customerId" value="@Model.Customer.Id" />
                        <div class="form-group mb-3">
                            <label for="amountPaid" class="form-label">Amount Paid:</label>
                            <input type="number" step="0.01" id="amountPaid" name="amountPaid" class="form-control" value="0.00" min="0.01" />
                        </div>
                        <div class="form-group mb-3">
                            <label for="paymentMode" class="form-label">Payment Mode:</label>
                            <select id="paymentMode" name="paymentMode" class="form-control">
                                <option value="Cash">Cash</option>
                                <option value="UPI">UPI</option>
                                <option value="Card">Card</option>
                                <option value="Bank Transfer">Bank Transfer</option>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-warning w-100">Record Payment</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4>Transaction History</h4>
                </div>
                <div class="card-body">
                    @if (!Model.Transactions.Any())
                    {
                        <p class="text-muted">No transactions recorded for this customer yet.</p>
                    }
                    else
                    {
                        <table class="table table-striped table-bordered">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Item</th>
                                    <th>Qty</th>
                                    <th>Price</th>
                                    <th>Discount</th>
                                    <th>Final</th>
                                    <th>Credit?</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var transaction in Model.Transactions)
                                {
                                    <tr>
                                        <td>@transaction.PurchaseDate.ToLocalTime().ToString("g")</td>
                                        <td>@transaction.Product?.Name (@(transaction.Product?.QuantityValue)@(transaction.Product?.QuantityUnit))</td>
                                        <td>@transaction.Quantity</td>
                                        <td>@transaction.TotalAmount.ToString("C", indiaCulture)</td>
                                        <td>@transaction.DiscountAmount.ToString("C", indiaCulture) (@transaction.DiscountPercentage.ToString("F2")%)</td>
                                        <td>@transaction.FinalAmount.ToString("C", indiaCulture)</td>
                                        <td>@(transaction.IsCreditTransaction ? "Yes" : "No")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card shadow-sm">
                <div class="card-header bg-secondary text-white">
                    <h4>Payment History</h4>
                </div>
                <div class="card-body">
                    @if (!Model.Payments.Any())
                    {
                        <p class="text-muted">No payments recorded for this customer yet.</p>
                    }
                    else
                    {
                        <table class="table table-striped table-bordered">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Amount Paid</th>
                                    <th>Mode</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var payment in Model.Payments)
                                {
                                    <tr>
                                        <td>@payment.PaymentDate.ToLocalTime().ToString("g")</td>
                                        <td>@payment.AmountPaid.ToString("C", indiaCulture)</td>
                                        <td>@payment.PaymentMode</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script>
    $(document).ready(function () {
        const customerId = $('#customerId').val();
        const discountInfoDiv = $('#discountInfo');
        const discountMessageSpan = $('#discountMessage');
        const originalAmountSpan = $('#originalAmountSpan');
        const discountAmountSpan = $('#discountAmountSpan');
        const finalAmountSpan = $('#finalAmountSpan');
        const recordSaleButton = $('#addItemForm button[type="submit"]');

        function updateDiscountUI(discountAmount, finalAmount, originalAmount, message) {
            const indiaCurrency = { style: 'currency', currency: 'INR' };
            originalAmountSpan.text(originalAmount.toLocaleString('en-IN', indiaCurrency));
            discountAmountSpan.text(discountAmount.toLocaleString('en-IN', indiaCurrency));
            finalAmountSpan.text(finalAmount.toLocaleString('en-IN', indiaCurrency));
            
            if (message) {
                discountMessageSpan.text(message);
            }

            discountInfoDiv.show();
        }

        async function fetchDiscount() {
            const productId = $('#productId').val();
            const quantity = $('#quantity').val();
            const selectedFestivalId = $('#applyDiscountFestivalId').val();

            if (!selectedFestivalId || !productId || !quantity || quantity <= 0) {
                discountInfoDiv.hide();
                recordSaleButton.prop('disabled', false); // Enable button if no discount is requested
                return;
            }

            const selectedProductOption = $('#productId option:selected');
            const unitPrice = selectedProductOption.data('price');
            const originalAmount = parseFloat(unitPrice) * parseInt(quantity);

            const data = {
                customerId: customerId,
                productId: parseInt(productId),
                quantity: parseInt(quantity),
                unitPrice: parseFloat(unitPrice),
                applyDiscountFestivalId: parseInt(selectedFestivalId) // Pass festival ID to the backend
            };

            try {
                const response = await fetch('/Transaction/CalculateDiscount', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    body: JSON.stringify(data)
                });

                if (response.ok) {
                    const result = await response.json();
                    updateDiscountUI(result.discountAmount, result.finalAmount, originalAmount, result.message);
                    
                    if (result.discountAmount > 0) {
                        recordSaleButton.prop('disabled', false);
                    } else {
                        recordSaleButton.prop('disabled', true);
                    }
                } else {
                    const errorResult = await response.json();
                    console.error('Error calculating discount:', errorResult.message);
                    updateDiscountUI(0, originalAmount, originalAmount, `Error: ${errorResult.message}`);
                    recordSaleButton.prop('disabled', true);
                }
            } catch (error) {
                console.error('Network or parsing error:', error);
                updateDiscountUI(0, originalAmount, originalAmount, 'Network error. Please try again.');
                recordSaleButton.prop('disabled', true);
            }
        }

        // Listen for changes in the form inputs to trigger discount calculation
        $('#productId, #quantity, #applyDiscountFestivalId').on('change keyup', fetchDiscount);

        // Initial fetch when the page loads if a product is already selected
        fetchDiscount();
    });
</script>