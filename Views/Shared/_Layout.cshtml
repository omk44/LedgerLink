@using Microsoft.AspNetCore.Http;

@{
    // Access shop info from session (set during login)
    var shopName = Context.Session.GetString("ShopName") ?? "LedgerLink";
    var appName = "LedgerLink";
    var shopEmail = Context.Session.GetString("AdminEmail") ?? "";
    var shopPhoneNumber = Context.Session.GetString("ShopPhoneNumber") ?? "";
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.Name;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;

    ViewData["Title"] ??= appName; // Set default title if not already set by a view
}

<!DOCTYPE html>
<html lang="@currentCulture">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @appName</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard-modern.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LedgerLink.styles.css" asp-append-version="true" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
</head>

<body>
    <!-- Top Header Bar -->
    <div class="top-header bg-light border-bottom">
        <div class="container-fluid">
            <div class="row align-items-center py-2">
                <div class="col-md-8">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-store text-primary me-2"></i>
                        <span class="fw-bold text-dark">@shopName</span>
                        <span class="text-muted ms-2">- Advanced Credit Management System</span>
                    </div>
                </div>
                <div class="col-md-4 text-end">
                    <div class="contact-info">
                        @if (!string.IsNullOrEmpty(shopEmail))
                        {
                            <a href="mailto:@shopEmail" class="text-muted me-3 text-decoration-none">
                                <i class="fas fa-envelope me-1"></i>@shopEmail
                            </a>
                        }
                        @if (!string.IsNullOrEmpty(shopPhoneNumber))
                        {
                            <a href="tel:@shopPhoneNumber" class="text-muted text-decoration-none">
                                <i class="fas fa-phone me-1"></i>@shopPhoneNumber
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Navigation -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm border-bottom">
            <div class="container-fluid">
                <!-- Brand with Logo -->
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <div class="brand-logo me-3">
                        <i class="fas fa-qrcode"></i>
                    </div>
                    <div class="brand-text">
                        <div class="brand-name">@appName</div>
                        <div class="brand-subtitle">Digital Khata Solution</div>
                    </div>
                </a>

                <!-- Toggler -->
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                    aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Navigation Links -->
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="fas fa-home me-1"></i>@SR["Home"]
                            </a>
                        </li>
                        
                        @if (Context.Session.GetString("IsAdminLoggedIn") == "true")
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Dashboard" asp-action="Index">
                                    <i class="fas fa-tachometer-alt me-1"></i>@SR["Dashboard"]
                                </a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fas fa-cogs me-1"></i>@SR["Management"]
                                </a>
                                <ul class="dropdown-menu shadow-lg border-0">
                                    <li>
                                        <a class="dropdown-item" asp-area="" asp-controller="Customer" asp-action="Index">
                                            <i class="fas fa-users me-2 text-primary"></i>@SR["Customers"]
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-area="" asp-controller="Product" asp-action="Index">
                                            <i class="fas fa-box me-2 text-success"></i>@SR["Products"]
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-area="" asp-controller="Festival" asp-action="Index">
                                            <i class="fas fa-percentage me-2 text-warning"></i>@SR["FestivalsAndDiscounts"]
                                        </a>
                                    </li>
                                </ul>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link btn-scan" asp-area="" asp-controller="Transaction" asp-action="Scan">
                                    <i class="fas fa-qrcode me-1"></i>@SR["ScanAndTransact"]
                                </a>
                            </li>
                        }
                    </ul>

                    <!-- Right side navigation -->
                    <ul class="navbar-nav align-items-lg-center">
                        <li class="nav-item dropdown me-lg-2">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fas fa-language me-1"></i>@SR["Language"]
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0">
                                <li>
                                    <a class="dropdown-item" asp-controller="Home" asp-action="SetLanguage" asp-route-culture="en-IN" asp-route-returnUrl="@returnUrl">@SR["English"]</a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Home" asp-action="SetLanguage" asp-route-culture="hi-IN" asp-route-returnUrl="@returnUrl">@SR["Hindi"]</a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Home" asp-action="SetLanguage" asp-route-culture="gu-IN" asp-route-returnUrl="@returnUrl">@SR["Gujarati"]</a>
                                </li>
                            </ul>
                        </li>
                        @if (Context.Session.GetString("IsAdminLoggedIn") == "true")
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <div class="user-avatar me-2">
                                        <i class="fas fa-user-shield"></i>
                                    </div>
                                    Admin
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0">
                                    <li>
                                        <h6 class="dropdown-header">
                                            <i class="fas fa-user-circle me-2"></i>@SR["Account"]
                                        </h6>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item text-danger" asp-area="" asp-controller="Account" asp-action="Logout">
                                            <i class="fas fa-sign-out-alt me-2"></i>@SR["Logout"]
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link btn-login" asp-area="" asp-controller="Account" asp-action="Login">
                                    <i class="fas fa-sign-in-alt me-1"></i>@SR["Login"]
                                </a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Privacy">
                                <i class="fas fa-shield-alt me-1"></i>@SR["Privacy"]
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer bg-light border-top mt-5">
        <div class="container-fluid py-4">
            <div class="row">
                <div class="col-md-6">
                    <div class="footer-brand mb-3">
                        <h5 class="text-dark mb-2">
                            <i class="fas fa-qrcode me-2 text-primary"></i>@appName
                        </h5>
                        <p class="text-muted mb-0">Advanced Customer Credit Amount Management System</p>
                        <p class="text-muted">Digital solution for traditional shops and wholesale businesses</p>
                    </div>
                </div>
                <div class="col-md-3">
                    <h6 class="text-dark mb-3">Contact Information</h6>
                    <div class="footer-contact">
                        <p class="mb-2">
                            <strong class="text-dark">@shopName</strong>
                        </p>
                        @if (!string.IsNullOrEmpty(shopEmail))
                        {
                            <p class="mb-1">
                                <i class="fas fa-envelope me-2 text-primary"></i>
                                <a href="mailto:@shopEmail" class="text-muted text-decoration-none">@shopEmail</a>
                            </p>
                        }
                        @if (!string.IsNullOrEmpty(shopPhoneNumber))
                        {
                            <p class="mb-1">
                                <i class="fas fa-phone me-2 text-primary"></i>
                                <a href="tel:@shopPhoneNumber" class="text-muted text-decoration-none">@shopPhoneNumber</a>
                            </p>
                        }
                    </div>
                </div>
                <div class="col-md-3">
                    <h6 class="text-dark mb-3">Quick Links</h6>
                    <ul class="list-unstyled">
                        <li class="mb-2">
                            <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-muted text-decoration-none">
                                <i class="fas fa-chevron-right me-2"></i>Privacy Policy
                            </a>
                        </li>
                        <li class="mb-2">
                            <a href="#" class="text-muted text-decoration-none">
                                <i class="fas fa-chevron-right me-2"></i>Terms of Service
                            </a>
                        </li>
                        <li class="mb-2">
                            <a href="#" class="text-muted text-decoration-none">
                                <i class="fas fa-chevron-right me-2"></i>Support
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
            <hr class="my-4">
            <div class="row">
                <div class="col-12 text-center">
                    <p class="mb-0 text-muted">
                        &copy; @DateTime.Now.Year @shopName - @appName. All rights reserved.
                        <span class="ms-3">
                            <i class="fas fa-code me-1"></i>Built with ASP.NET Core
                        </span>
                    </p>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>