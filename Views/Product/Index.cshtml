@* Path: LedgerLink/Views/Product/Index.cshtml *@
@model IEnumerable<LedgerLink.Models.Product>

@{
    ViewData["Title"] = "Product List";
}

<div class="container mt-5">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary">
            <i class="bi bi-box-seam me-2"></i> @ViewData["Title"]
        </h2>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle me-1"></i> Add Product
        </a>
    </div>

    <!-- Product Table -->
    <div class="table-responsive shadow-sm rounded">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Name)</th>
                    <th>@Html.DisplayNameFor(model => model.Price)</th>
                    <th>Quantity</th>
                    <th>@Html.DisplayNameFor(model => model.Description)</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-semibold">@Html.DisplayFor(modelItem => item.Name)</td>

                        <!-- Price in INR -->
                        <td class="text-success fw-bold">
                            @item.Price.ToString("C", new System.Globalization.CultureInfo("en-IN"))
                        </td>

                        <!-- Quantity -->
                        <td>
                            @if (item.QuantityValue > 0 && !string.IsNullOrEmpty(item.QuantityUnit))
                            {
                                <span class="badge bg-info px-3 py-2">
                                    @($"{item.QuantityValue} {item.QuantityUnit}")
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">N/A</span>
                            }
                        </td>

                        <!-- Description -->
                        <td>@Html.DisplayFor(modelItem => item.Description)</td>

                        <!-- Actions -->
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info me-1">
                                <i class="bi bi-pencil-square"></i> Edit
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash"></i> Delete
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    .table-responsive {
        background: #fff;
        border-radius: 8px;
    }
    .table-hover tbody tr:hover {
        background-color: #f8f9fa;
    }
</style>
