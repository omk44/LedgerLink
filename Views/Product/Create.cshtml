@* Path: LedgerLink/Views/Product/Create.cshtml *@
@model LedgerLink.Models.Product

@{
    ViewData["Title"] = "Create Product";
}

<div class="container mt-5">
    <h2>@ViewData["Title"]</h2>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <!-- Product Name -->
                <div class="form-group mb-3">
                    <label asp-for="Name" class="control-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <!-- Price -->
                <div class="form-group mb-3">
                    <label asp-for="Price" class="control-label"></label>
                    <input asp-for="Price" class="form-control" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>

                <!-- Description -->
                <div class="form-group mb-3">
                    <label asp-for="Description" class="control-label"></label>
                    <textarea asp-for="Description" class="form-control"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <!-- Quantity Value -->
                <div class="form-group mb-3">
                    <label asp-for="QuantityValue" class="control-label"></label>
                    <input asp-for="QuantityValue" class="form-control" />
                    <span asp-validation-for="QuantityValue" class="text-danger"></span>
                </div>

                <!-- Quantity Unit Dropdown -->
                <div class="form-group mb-3">
                    <label asp-for="QuantityUnit" class="control-label"></label>
                    <select asp-for="QuantityUnit" class="form-control">
                        <option value="pcs">pcs</option>
                        <option value="ml">ml</option>
                        <option value="gm">gm</option>
                        <option value="kg">kg</option>
                        <option value="ltr">ltr</option>
                    </select>
                    <span asp-validation-for="QuantityUnit" class="text-danger"></span>
                </div>

                <!-- Submit Buttons -->
                <div class="form-group">
                    <input type="submit" value="Create" class="btn btn-primary" />
                    <a asp-action="Index" class="btn btn-secondary ml-2">Back to List</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
