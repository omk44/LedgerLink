@* Path: LedgerLink/Views/Product/Edit.cshtml *@
@model LedgerLink.Models.Product

@{
    ViewData["Title"] = SR["EditProduct"];
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-header bg-warning text-dark text-center">
                    <h3 class="mb-0 fw-bold">@ViewData["Title"]</h3>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                        <input type="hidden" asp-for="Id" />

                        <!-- Product Name -->
                        <div class="form-group mb-3">
                            <label asp-for="Name" class="form-label fw-semibold"></label>
                            <input asp-for="Name" class="form-control" placeholder="@SR["EnterProductName"]" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <!-- Price -->
                        <div class="form-group mb-3">
                            <label asp-for="Price" class="form-label fw-semibold"></label>
                            <input asp-for="Price" class="form-control" placeholder="@SR["EnterPriceInInr"]" />
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>

                        <!-- Description -->
                        <div class="form-group mb-3">
                            <label asp-for="Description" class="form-label fw-semibold"></label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="@SR["EnterProductDescription"]"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <!-- Quantity Value -->
                        <div class="form-group mb-3">
                            <label asp-for="QuantityValue" class="form-label fw-semibold"></label>
                            <input asp-for="QuantityValue" class="form-control" placeholder="@SR["EnterQuantity"]" />
                            <span asp-validation-for="QuantityValue" class="text-danger small"></span>
                        </div>

                        <!-- Quantity Unit Dropdown -->
                        <div class="form-group mb-4">
                            <label asp-for="QuantityUnit" class="form-label fw-semibold"></label>
                            <select asp-for="QuantityUnit" class="form-select">
                                <option value="">@SR["SelectUnit"]</option>
                                <option value="pcs">pcs</option>
                                <option value="ml">ml</option>
                                <option value="gm">gm</option>
                                <option value="kg">kg</option>
                                <option value="ltr">ltr</option>
                                <option value="pack">pack</option>
                            </select>
                            <span asp-validation-for="QuantityUnit" class="text-danger small"></span>
                        </div>

                        <!-- Submit Buttons -->
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> @SR["BackToList"]
                            </a>
                            <button type="submit" class="btn btn-warning text-dark px-4">
                                <i class="bi bi-pencil-square"></i> @SR["SaveChanges"]
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
