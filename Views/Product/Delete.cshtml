@* Path: LedgerLink/Views/Product/Delete.cshtml *@
@model LedgerLink.Models.Product

@{
    ViewData["Title"] = SR["DeleteProduct"];
}

<div class="container mt-5">
    <h2>@ViewData["Title"]</h2>
    <h3 class="text-danger">@SR["ConfirmDeleteProduct"]</h3>
    <hr />
    <div>
        <h4>@SR["ProductDetails"]</h4>
        <dl class="row">
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Name)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Name)
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Price)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Price)
            </dd>
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Description)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Description)
            </dd>
        </dl>

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" /> @* Hidden field for the Product Id *@
            <input type="submit" value="@SR["Delete"]" class="btn btn-danger" />
            <a asp-action="Index" class="btn btn-secondary ml-2">@SR["BackToList"]</a>
        </form>
    </div>
</div>