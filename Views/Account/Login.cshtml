@* Path: LedgerLink/Views/Account/Login.cshtml *@
@model LedgerLink.ViewModels.LoginViewModel 

@{
    ViewData["Title"] = "Admin Login - LedgerLink";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet" />
    <style>
        body {
            background: linear-gradient(135deg, #ffffff 0%, #ffffff 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .login-container {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .login-card {
            background: #ffffff;
            border-radius: 20px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
            overflow: hidden;
            max-width: 900px;
            width: 100%;
            border: 1px solid #e9ecef;
        }

        .login-left {
            background: linear-gradient(45deg, #2c3e50, #34495e);
            color: white;
            padding: 60px 40px;
            text-align: center;
            position: relative;
        }

        .login-left::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="grain" width="100" height="100" patternUnits="userSpaceOnUse"><circle cx="50" cy="50" r="1" fill="white" opacity="0.1"/></pattern></defs><rect width="100" height="100" fill="url(%23grain)"/></svg>');
            opacity: 0.3;
        }

        .login-left .content {
            position: relative;
            z-index: 2;
        }

        .system-icon {
            font-size: 4rem;
            margin-bottom: 20px;
            color: #3498db;
        }

        .system-title {
            font-size: 2.2rem;
            font-weight: bold;
            margin-bottom: 15px;
            line-height: 1.2;
        }

        .system-subtitle {
            font-size: 1.1rem;
            opacity: 0.9;
            margin-bottom: 30px;
        }

        .features-list {
            text-align: left;
            max-width: 300px;
            margin: 0 auto;
        }

        .feature-item {
            display: flex;
            align-items: center;
            margin-bottom: 15px;
            font-size: 0.95rem;
        }

        .feature-item i {
            color: #3498db;
            margin-right: 12px;
            width: 20px;
        }

        .login-right {
            padding: 60px 50px;
        }

        .login-header {
            text-align: center;
            margin-bottom: 40px;
        }

        .login-header h2 {
            color: #2c3e50;
            font-weight: 600;
            margin-bottom: 10px;
        }

        .login-header p {
            color: #7f8c8d;
            font-size: 1rem;
        }

        .form-group {
            margin-bottom: 25px;
        }

        .form-label {
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 8px;
        }

        .form-control {
            border: 2px solid #e9ecef;
            border-radius: 10px;
            padding: 15px 20px;
            font-size: 1rem;
            transition: all 0.3s ease;
        }

        .form-control:focus {
            border-color: #3498db;
            box-shadow: 0 0 0 0.2rem rgba(52, 152, 219, 0.25);
        }

        .input-group {
            position: relative;
        }

        .input-icon {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #7f8c8d;
            z-index: 5;
        }

        .login-btn {
            background: linear-gradient(45deg, #4facfe, #00f2fe);
            border: none;
            border-radius: 10px;
            padding: 15px 30px;
            font-size: 1.1rem;
            font-weight: 600;
            color: white;
            width: 100%;
            transition: all 0.3s ease;
            margin-top: 10px;
        }

        .login-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(79, 172, 254, 0.3);
            background: linear-gradient(45deg, #00f2fe, #4facfe);
        }

        .forgot-password {
            text-align: center;
            margin-top: 20px;
        }

        .forgot-password a {
            color: #3498db;
            text-decoration: none;
            font-size: 0.95rem;
        }

        .forgot-password a:hover {
            text-decoration: underline;
        }

        .footer-text {
            text-align: center;
            margin-top: 30px;
            color: #95a5a6;
            font-size: 0.9rem;
        }

        @@media (max-width: 768px) {
            .login-left {
                display: none;
            }
            .login-right {
                padding: 40px 30px;
            }
            .system-title {
                font-size: 1.8rem;
            }
        }

        .validation-summary-errors {
            background-color: #f8d7da;
            border: 1px solid #f5c6cb;
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 20px;
        }

        .validation-summary-errors ul {
            margin: 0;
            padding-left: 20px;
        }

        .text-danger {
            font-size: 0.875rem;
            margin-top: 5px;
        }
    </style>
</head>
<body>
    <div class="login-container">
        <div class="login-card">
            <div class="row g-0 h-100">
                <!-- Left Panel - System Information -->
                <div class="col-lg-5 login-left">
                    <div class="content">
                        <div class="system-icon">
                            <i class="fas fa-qrcode"></i>
                        </div>
                        <h1 class="system-title">LedgerLink</h1>
                        <p class="system-subtitle">Advanced Customer Credit Amount Management System</p>
                        
                        <div class="features-list">
                            <div class="feature-item">
                                <i class="fas fa-qrcode"></i>
                                <span>QR Code Customer Management</span>
                            </div>
                            <div class="feature-item">
                                <i class="fas fa-shopping-cart"></i>
                                <span>Purchase Tracking & Credit System</span>
                            </div>
                            <div class="feature-item">
                                <i class="fas fa-percentage"></i>
                                <span>Festival Discount Management</span>
                            </div>
                            <div class="feature-item">
                                <i class="fas fa-chart-bar"></i>
                                <span>Digital Khata Book Solution</span>
                            </div>
                            <div class="feature-item">
                                <i class="fas fa-store"></i>
                                <span>Perfect for Village & Wholesale Shops</span>
                            </div>
                            <div class="feature-item">
                                <i class="fas fa-mobile-alt"></i>
                                <span>No Physical Notes Required</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right Panel - Login Form -->
                <div class="col-lg-7 login-right">
                    <div class="login-header">
                        <h2>Admin Login</h2>
                        <p>Access your shop management dashboard</p>
                    </div>

                    @* Display success message from registration *@
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-action="Login" method="post">
                        @* Display validation errors *@
                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div asp-validation-summary="All" class="validation-summary-errors">
                                <i class="fas fa-exclamation-triangle me-2"></i>
                                Please correct the errors below:
                            </div>
                        }

                        <div class="form-group">
                            <label asp-for="Username" class="form-label">
                                <i class="fas fa-user me-2"></i>Username
                            </label>
                            <div class="input-group">
                                <input asp-for="Username" class="form-control" placeholder="Enter your username" autofocus />
                                <i class="fas fa-user input-icon"></i>
                            </div>
                            <span asp-validation-for="Username" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Password" class="form-label">
                                <i class="fas fa-lock me-2"></i>Password
                            </label>
                            <div class="input-group">
                                <input asp-for="Password" type="password" class="form-control" placeholder="Enter your password" />
                                <i class="fas fa-lock input-icon"></i>
                            </div>
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="text-end mb-3">
                            <a href="@Url.Action("ForgotPassword", "AdminManagement")" style="color: #3498db; text-decoration: none; font-size: 0.9rem;">
                                <i class="fas fa-key"></i> Forgot Password?
                            </a>
                        </div>

                        <button type="submit" class="btn login-btn">
                            <i class="fas fa-sign-in-alt me-2"></i>
                            Login to Dashboard
                        </button>

                        <div class="text-center mt-3">
                            <p style="color: #7f8c8d; margin-bottom: 10px;">Don't have an account?</p>
                            <a href="@Url.Action("Register", "Shop")" class="btn btn-outline-primary" style="border-radius: 10px; padding: 12px 30px; font-weight: 600;">
                                <i class="fas fa-store me-2"></i>Register Your Shop
                            </a>
                        </div>

                        
                    </form>

                    <div class="footer-text">
                        <i class="fas fa-shield-alt me-1"></i>
                        Secure Shop Management System<br>
                        <small>&copy; 2024 LedgerLink - Digital Khata Solution</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* JavaScript *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
    
    <script>
        // Add some interactive elements
        document.addEventListener('DOMContentLoaded', function() {
            // Add focus effects to form inputs
            const inputs = document.querySelectorAll('.form-control');
            inputs.forEach(input => {
                input.addEventListener('focus', function() {
                    this.parentElement.style.transform = 'scale(1.02)';
                });
                input.addEventListener('blur', function() {
                    this.parentElement.style.transform = 'scale(1)';
                });
            });

            // Add loading state to login button
            const loginForm = document.querySelector('form');
            const loginBtn = document.querySelector('.login-btn');
            const originalBtnText = loginBtn.innerHTML;

            loginForm.addEventListener('submit', function() {
                loginBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Logging in...';
                loginBtn.disabled = true;
                
                // Re-enable after 5 seconds in case of error
                setTimeout(() => {
                    loginBtn.innerHTML = originalBtnText;
                    loginBtn.disabled = false;
                }, 5000);
            });
        });
    </script>
</body>
</html>