@* Path: LedgerLink/Views/DiscountRule/Edit.cshtml *@
@model LedgerLink.Models.DiscountRule

@{
    ViewData["Title"] = $"Edit Rule for {ViewBag.FestivalName}";
}

<div class="container mt-5">
    <h2>@ViewData["Title"]</h2>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="FestivalId" />

                <div class="form-group mb-3">
                    <label asp-for="DiscountPercentage" class="control-label"></label>
                    <input asp-for="DiscountPercentage" class="form-control" />
                    <span asp-validation-for="DiscountPercentage" class="text-danger"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="MinCustomerCreditBalance" class="control-label"></label>
                    <input asp-for="MinCustomerCreditBalance" class="form-control" />
                    <span asp-validation-for="MinCustomerCreditBalance" class="text-danger"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="MaxCustomerCreditBalance" class="control-label"></label>
                    <input asp-for="MaxCustomerCreditBalance" class="form-control" />
                    <span asp-validation-for="MaxCustomerCreditBalance" class="text-danger"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="MinPurchaseAmount" class="control-label"></label>
                    <input asp-for="MinPurchaseAmount" class="form-control" />
                    <span asp-validation-for="MinPurchaseAmount" class="text-danger"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="Description" class="control-label"></label>
                    <textarea asp-for="Description" class="form-control"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <input type="submit" value="Save" class="btn btn-primary" />
                    <a asp-action="Index" asp-route-festivalId="@ViewBag.FestivalId" class="btn btn-secondary ml-2">Back to Rules</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}