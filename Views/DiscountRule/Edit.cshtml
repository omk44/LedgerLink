@* Path: LedgerLink/Views/DiscountRule/Edit.cshtml *@
@model LedgerLink.Models.DiscountRule

@{
    ViewData["Title"] = $"Edit Rule for {ViewBag.FestivalName}";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-header bg-warning text-dark text-center">
                    <h3 class="mb-0 fw-bold">
                        <i class="bi bi-pencil-square me-2"></i> @ViewData["Title"]
                    </h3>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="FestivalId" />

                        <!-- Discount % -->
                        <div class="form-group mb-3">
                            <label asp-for="DiscountPercentage" class="form-label fw-semibold"></label>
                            <input asp-for="DiscountPercentage" class="form-control" type="number" step="0.01" placeholder="Enter discount percentage" />
                            <span asp-validation-for="DiscountPercentage" class="text-danger small"></span>
                        </div>

                        <!-- Min Credit -->
                        <div class="form-group mb-3">
                            <label asp-for="MinCustomerCreditBalance" class="form-label fw-semibold"></label>
                            <input asp-for="MinCustomerCreditBalance" class="form-control" type="number" step="0.01" placeholder="Enter minimum credit balance" />
                            <span asp-validation-for="MinCustomerCreditBalance" class="text-danger small"></span>
                        </div>

                        <!-- Max Credit -->
                        <div class="form-group mb-3">
                            <label asp-for="MaxCustomerCreditBalance" class="form-label fw-semibold"></label>
                            <input asp-for="MaxCustomerCreditBalance" class="form-control" type="number" step="0.01" placeholder="Enter maximum credit balance" />
                            <span asp-validation-for="MaxCustomerCreditBalance" class="text-danger small"></span>
                        </div>

                        <!-- Min Purchase -->
                        <div class="form-group mb-3">
                            <label asp-for="MinPurchaseAmount" class="form-label fw-semibold"></label>
                            <input asp-for="MinPurchaseAmount" class="form-control" type="number" step="0.01" placeholder="Enter minimum purchase amount" />
                            <span asp-validation-for="MinPurchaseAmount" class="text-danger small"></span>
                        </div>

                        <!-- Description -->
                        <div class="form-group mb-4">
                            <label asp-for="Description" class="form-label fw-semibold"></label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Enter description"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <!-- Submit Buttons -->
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" asp-route-festivalId="@ViewBag.FestivalId" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Back to Rules
                            </a>
                            <button type="submit" class="btn btn-warning text-dark px-4">
                                <i class="bi bi-check-circle"></i> Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
