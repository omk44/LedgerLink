@* Path: LedgerLink/Views/DiscountRule/Index.cshtml *@
@model IEnumerable<LedgerLink.Models.DiscountRule>

@{
    ViewData["Title"] = $"Rules for {ViewBag.FestivalName}";
}

<div class="container mt-5">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary">
            <i class="bi bi-tags-fill me-2"></i> @ViewData["Title"]
        </h2>
        <div>
            <a asp-action="Create" asp-route-festivalId="@ViewBag.FestivalId" class="btn btn-success me-2">
                <i class="bi bi-plus-circle me-1"></i> Add New Rule
            </a>
            <a asp-action="Index" asp-controller="Festival" class="btn btn-secondary">
                <i class="bi bi-arrow-left-circle me-1"></i> Back to Festivals
            </a>
        </div>
    </div>

    <!-- Rules Table -->
    <div class="table-responsive shadow-sm rounded">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Discount %</th>
                    <th>Min Credit</th>
                    <th>Max Credit</th>
                    <th>Min Purchase</th>
                    <th>Description</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <!-- Discount -->
                        <td class="fw-semibold text-success">
                            @item.DiscountPercentage%
                        </td>

                        <!-- Min Credit -->
                        <td>
                            @item.MinCustomerCreditBalance.ToString("C0", new System.Globalization.CultureInfo("en-IN"))
                        </td>

                        <!-- Max Credit -->
                        <td>
                            @item.MaxCustomerCreditBalance.ToString("C0", new System.Globalization.CultureInfo("en-IN"))
                        </td>

                        <!-- Min Purchase -->
                        <td>
                            @item.MinPurchaseAmount.ToString("C0", new System.Globalization.CultureInfo("en-IN"))
                        </td>

                        <!-- Description -->
                        <td>@Html.DisplayFor(modelItem => item.Description)</td>

                        <!-- Actions -->
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info me-1">
                                <i class="bi bi-pencil-square"></i> Edit
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash"></i> Delete
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    .table-responsive {
        background: #fff;
        border-radius: 8px;
    }
    .table-hover tbody tr:hover {
        background-color: #f8f9fa;
    }
</style>
